# ────────────────────────────────────────────────────────────────────────────
#  EHPAD Agir — Template variables d'environnement
#  1. Copier ce fichier vers .env
#  2. Remplacer TOUTES les valeurs marquées CHANGER
#  3. Ne jamais committer .env
# ────────────────────────────────────────────────────────────────────────────

# ── Serveur ────────────────────────────────────────────────────────────────
SERVER_PORT=8081

# ── Base de données ────────────────────────────────────────────────────────
DB_HOST=postgres
DB_PORT=5432
DB_NAME=ehpad
DB_USER=ehpad_app
DB_PASSWORD=CHANGER_MOT_DE_PASSE_MIN_32_CHARS

# ── JWT ────────────────────────────────────────────────────────────────────
# Générer : openssl rand -base64 48
JWT_SECRET=CHANGER_CLE_SECRETE_BASE64_48_OCTETS
JWT_EXPIRATION=86400000

# ── Comptes par défaut ─────────────────────────────────────────────────────
APP_ADMIN_PASSWORD=CHANGER_MIN_16_CHARS
APP_INFIRMIERE_PASSWORD=CHANGER_MIN_16_CHARS

# ── CORS ───────────────────────────────────────────────────────────────────
# Développement : http://localhost:5173
# Production    : https://ehpad-agir.fr
ALLOWED_ORIGINS=http://localhost:5173
