# ────────────────────────────────────────────────────────────
#  EHPAD Agir — Template des variables d'environnement
#  Copier ce fichier vers .env et renseigner les valeurs
# ────────────────────────────────────────────────────────────

SERVER_PORT=8081

# ── Base de données DEV (H2 in-memory) ─────────────────────
DB_URL=jdbc:h2:mem:testdb
DB_DRIVER=org.h2.Driver
DB_USERNAME=sa
DB_PASSWORD=

# ── Base de données PostgreSQL (prod / docker-compose) ─────
DB_HOST=localhost
DB_PORT=5432
DB_NAME=ehpad
DB_USER=ehpad
DB_PASSWORD=REMPLACER_PAR_MOT_DE_PASSE_FORT

# ── JWT — générer avec : openssl rand -base64 48 ───────────
JWT_SECRET=REMPLACER_PAR_UNE_CLE_SECRETE_BASE64_MIN_48_OCTETS
JWT_EXPIRATION=86400000

# ── Comptes par défaut ──────────────────────────────────────
APP_ADMIN_PASSWORD=REMPLACER_PAR_MOT_DE_PASSE_FORT
APP_INFIRMIERE_PASSWORD=REMPLACER_PAR_MOT_DE_PASSE_FORT
